AGI_CONFIG=config/default.toml
AGI_PROVIDER=echo
AGI_PROVIDER_KIND=echo
AGI_BASE_URL=http://127.0.0.1:8000/v1
AGI_MODEL=deepseek-chat
AGI_API_KEY_ENV=AGI_API_KEY
